# ===== 비밀값 =====
.env
.env.*
# 예시 파일은 공유 (키 이름만, 값은 비움)
!.env.example

# ===== Python =====
__pycache__/
# .pyc / .pyo / .pyd 한 번에
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# ===== 테스트·린트 캐시 =====
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ===== Jupyter =====
.ipynb_checkpoints/

# ===== 데이터 (절대 커밋 금지: 기업 제공 데이터 포함) =====
# 폴더는 남기고 내용물만 무시 → 아래 예외(!)가 동작하려면 data/ 가 아니라 data/* 여야 함
data/*
# 폴더 구조와 데이터 받는 방법 문서만 공유
!data/.gitkeep
!data/README.md
# 영상
*.mp4
*.avi
*.mov
# VICON 모캡 원본 및 3D 포맷
*.c3d
*.fbx
*.bvh
# NumPy 배열
*.npy
*.npz

# ===== 대용량 모델 (README의 '모델 준비' 참고) =====
ai_service/models/
*.joblib
*.pt
*.joblib
*.pt
*.pth
*.onnx
*.ckpt
*.h5
*.tflite
*.engine

# ===== 학습·실험 결과물 =====
# YOLO 학습 결과
runs/
outputs/
logs/
# MLflow / W&B
mlruns/
wandb/

# ===== 편집기·OS =====
.vscode/
.idea/
.DS_Store
Thumbs.db

# ===== Windows에서 복사한 파일의 다운로드 출처 표시 (WSL에 함께 생김) =====
*:Zone.Identifier
db.sqlite3
media/
